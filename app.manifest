<?xml version="1.0" encoding="utf-8"?>
<!--
  NOTE FOR ANYONE EDITING THIS FILE: an XML comment may not contain a double
  hyphen. This project's prose uses one as an em dash constantly, and writing
  the comments below in the house style produced a manifest that Windows
  rejects with "Invalid Xml syntax" at LOAD time. That is not a degraded
  feature; the binary does not start at all, before main, with:

    The application has failed to start because its side-by-side
    configuration is incorrect. (os error 14001)

  It was caught only because the resource is compiled into the test binaries
  too and they stopped running. Use commas.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    No assemblyIdentity. It is optional for an application manifest, and
    Euterpe.Doctor's copy carries one only because link.exe merges that manifest
    into its own default. This one is compiled straight into an RT_MANIFEST
    resource with nothing to fix it up, so it says only what it means.
  -->

  <!--
    asInvoker, and here it is not merely unnecessary but actively required.
    Windows refuses drag and drop into an elevated window: Explorer runs at
    medium integrity, an elevated Press at high, and UIPI silently drops the
    message. The whole visible result is a forbidden cursor, on the one gesture
    this tool is built around. See src/elevation.rs, which exists to explain
    that when it happens anyway.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!--
        Declaring these is what stops Windows applying compatibility shims and
        lying to the program about its own version.
      -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- 10 / 11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- 8.1 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/> <!-- 8 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/> <!-- 7 -->
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        THE ONE THAT MATTERS MOST HERE. Press draws a video into a fixed
        960x640 canvas laid out to the pixel. Without per monitor v2 the system
        bitmap stretches that canvas on any display above 100%, which is most
        laptops. A tool whose entire job is showing somebody their own picture
        would be showing them a soft, resampled version of it, and the crop
        rectangle they drag would not land where they think it does.

        Declared here rather than left to a runtime call, because the manifest
        applies before the first window exists and a call made afterwards does
        not move one that is already up.
      -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <!--
        Editors nest exports deeply and charters keep projects on drives with
        long names. Without this, opening a path past 260 characters fails for a
        reason nothing on screen could explain.
      -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!--
        Every filename this tool touches is somebody's own, and they are
        routinely CJK. The ANSI code page would mangle them on the way to the
        encoder's argument list.
      -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
